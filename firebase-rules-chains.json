{
  "rules": {
    "pkclub": {
      "members": {
        ".read": true,
        "$key": {
          ".write": true,
          ".validate": "newData.hasChildren(['name', 'plan', 'court', 'day']) && (($key.endsWith('_sun') && newData.child('day').val() == 'sun') || ($key.endsWith('_fri') && newData.child('day').val() == 'fri'))",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
          "plan": { ".validate": "newData.val() == '季繳' || newData.val() == '月繳'" },
          "court": { ".validate": "newData.val() == '5' || newData.val() == '6'" },
          "day": { ".validate": "newData.val() == 'sun' || newData.val() == 'fri'" },
          "$other": { ".validate": false }
        }
      },
      "applications": {
        ".read": true,
        "$key": {
          ".write": true,
          ".validate": "newData.hasChildren(['name', 'plan', 'court', 'day', 'ts']) && (($key.endsWith('_sun') && newData.child('day').val() == 'sun') || ($key.endsWith('_fri') && newData.child('day').val() == 'fri'))",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
          "plan": { ".validate": "newData.val() == '季繳' || newData.val() == '月繳'" },
          "court": { ".validate": "newData.val() == '5' || newData.val() == '6'" },
          "day": { ".validate": "newData.val() == 'sun' || newData.val() == 'fri'" },
          "ts": { ".validate": "(!data.exists() && newData.val() == now) || newData.val() == data.val()" },
          "$other": { ".validate": false }
        }
      },
      "notices": {
        ".read": true,
        "$id": {
          ".write": true,
          ".validate": "newData.hasChildren(['text', 'ts', 'author'])",
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
          "pinned": { ".validate": "newData.isBoolean()" },
          "ts": { ".validate": "(!data.exists() && newData.val() == now) || newData.val() == data.val()" },
          "editedAt": { ".validate": "newData.val() == now || newData.val() == data.val()" },
          "author": {
            ".validate": "newData.hasChildren(['id', 'name'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 50" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "chains": {
      ".read": true,
      ".indexOn": ["createdAt"],
      "$chainId": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['title', 'date', 'time', 'place', 'price', 'createdAt', 'creator'])",
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "date": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
        "time": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
        "place": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "price": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
        "week": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60 && newData.val() % 1 == 0" },
        "day": { ".validate": "newData.val() == 'sun' || newData.val() == 'fri'" },
        "courts": {
          "$no": {
            ".validate": "($no == '5' || $no == '6') && newData.hasChildren(['kind', 'name', 'level'])",
            "kind": { ".validate": "newData.val() == '挑戰' || newData.val() == '交流' || newData.val() == '初學'" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "level": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "$other": { ".validate": false }
          }
        },
        "createdAt": { ".validate": "newData.val() == now" },
        "creator": {
          ".validate": "newData.hasChildren(['id', 'name'])",
          "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 50" },
          "$other": { ".validate": false }
        },
        "entries": {
          "$uid": {
            ".write": true,
            ".validate": "newData.hasChildren(['name', 'guests', 'ts', 'court'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
            "guests": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7 && newData.val() % 1 == 0" },
            "friends": {
              "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" }
            },
            "self": { ".validate": "newData.isBoolean() && newData.val() == false && newData.parent().child('guests').val() >= 1" },
            "dupr": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8" },
            "friendDupr": {
              "$i": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8" }
            },
            "pay": { ".validate": "newData.val() == 'cash' || newData.val() == 'linepay'" },
            "payReported": { ".validate": "newData.isBoolean()" },
            "paid": { ".validate": "newData.isBoolean()" },
            "court": { ".validate": "(newData.val() == '5' || newData.val() == '6') && root.child('chains/' + $chainId + '/courts/' + newData.val()).exists() && (!data.exists() || newData.val() == data.val())" },
            "ts": { ".validate": "(!data.exists() && newData.val() == now) || newData.val() == data.val()" },
            "$other": { ".validate": false }
          }
        },
        "leaves": {
          "$key": {
            ".write": true,
            ".validate": "newData.val() == true && root.child('pkclub/members/' + $key).exists()"
          }
        },
        "checkins": {
          "$uid": {
            ".write": true,
            ".validate": "newData.val() == true"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
